    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.2",
    "ioredis": "catalog:",
    "livekit-server-sdk": "catalog:",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
