{
  "name": "worker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "rm -rf dist && rolldown -c",
    "start": "node --import ./dist/apps/worker/src/instrumentation.js dist/apps/worker/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write --linter-enabled=false .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@firecrawl/anydoc": "0.2.5",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/instrumentation-runtime-node": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@qdrant/js-client-rest": "catalog:",
    "@workspace/email": "workspace:*",
    "@workspace/shared": "workspace:*",
    "ai": "catalog:",
    "bullmq": "catalog:",
    "bullmq-otel": "catalog:",
    "dotenv": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "rolldown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
