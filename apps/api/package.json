{
  "name": "api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "rm -rf dist && rolldown -c",
    "start": "node --import ./dist/apps/api/src/instrumentation.js dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write --linter-enabled=false .",
    "sync-inbound-sip": "tsx scripts/sync-inbound-sip.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@better-auth/api-key": "catalog:",
    "@better-auth/i18n": "catalog:",
    "@better-auth/sso": "catalog:",
    "@better-auth/stripe": "catalog:",
    "@hono/node-server": "^2.1.11",
    "@hono/otel": "catalog:",
    "@hono/zod-validator": "^0.9.1",
    "@livekit/protocol": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/instrumentation-runtime-node": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "bullmq-otel": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.20",
    "i18next": "catalog:",
    "ioredis": "catalog:",
    "livekit-server-sdk": "catalog:",
    "pino": "catalog:",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "rolldown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
